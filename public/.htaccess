RewriteEngine On

# ==========================================================================
# 1. Canonique : une seule adresse pour une seule page
# ==========================================================================
# www servait le site sans rediriger : Google voyait deux sites identiques.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ==========================================================================
# 2. Anciennes URL, refonte de septembre 2026
# ==========================================================================
# Chaque page supprimee pointe vers celle qui traite le meme sujet. Une
# redirection vers l'accueil est un dernier recours : Google la traite comme
# un soft 404 quand elle est systematique.

# Le vieux CV numerique, toujours indexe et toujours en 404 sur le .fr
RewriteRule ^cv-numerique/?$ / [R=301,L]
RewriteRule ^cv-numerique/(.*)$ / [R=301,L]

# Portfolio et etudes de cas -> les realisations
RewriteRule ^projets/?$ /realisations [R=301,L]
RewriteRule ^etudes-de-cas/?$ /realisations [R=301,L]
RewriteRule ^etudes-de-cas/(.*)$ /realisations [R=301,L]

# Blog -> guides
RewriteRule ^blog/?$ /guides [R=301,L]
RewriteRule ^blog/(.*)$ /guides [R=301,L]

# Tarifs et prix : le site ne publie plus de grille
RewriteRule ^tarifs/?$ /freelance [R=301,L]
RewriteRule ^prix/application-mobile/?$ /freelance [R=301,L]
RewriteRule ^prix/(.*)$ /freelance [R=301,L]
RewriteRule ^en/pricing/(.*)$ /freelance [R=301,L]

# Pages de service -> la page d'expertise ou de mission correspondante
RewriteRule ^services/creation-application-mobile/?$ /freelance [R=301,L]
RewriteRule ^services/developpement-saas/?$ /freelance [R=301,L]
RewriteRule ^services/(.*)$ /freelance [R=301,L]
RewriteRule ^en/services/(.*)$ /freelance [R=301,L]

# Les 48 pages de ville dupliquees. Celles de France pointent vers la page
# locale reelle, celles de Tunisie vers la page freelance : il n'y a plus
# d'offre locale tunisienne sur ce site.
RewriteRule ^fr-fr/(.*)$ /developpeur-application-mobile-amiens [R=301,L]
RewriteRule ^en-fr/(.*)$ /developpeur-application-mobile-amiens [R=301,L]
RewriteRule ^fr-tn/(.*)$ /freelance [R=301,L]
RewriteRule ^en-tn/(.*)$ /freelance [R=301,L]

# Sitemaps annonces par l'ancien robots.txt et jamais generes
RewriteRule ^sitemap-(fr|en|ar)\.xml$ /sitemap.xml [R=301,L]

# ==========================================================================
# 3. Servir les pages exportees a plat
# ==========================================================================
# Next exporte /contact dans contact.html, a cote d'un eventuel dossier
# homonyme. Sans DirectorySlash Off, Apache redirige vers le dossier et la
# page ne s'affiche jamais.
DirectorySlash Off

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

ErrorDocument 404 /404.html

# ==========================================================================
# 4. En-tetes de securite
# ==========================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Le site est statique : pas de script tiers, pas de XHR, pas d'iframe.
  # Les seules origines externes sont les polices Google, chargees par le
  # layout. 'unsafe-inline' reste necessaire pour les styles en ligne des
  # composants et pour les blocs JSON-LD.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ==========================================================================
# 5. Compression et cache
# ==========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Les fichiers de _next portent une empreinte dans leur nom : immuables.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 week"
  # Le HTML doit pouvoir changer a chaque deploiement.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
