RewriteEngine On

# Anciennes URL indexees : on les renvoie vers la page unique plutot que
# de laisser Google servir un 404 en premiere page sur le nom.
RewriteRule ^cv-numerique/?$ / [R=301,L]
RewriteRule ^cv-numerique/(.*)$ / [R=301,L]

# Next exporte des fichiers plats : /contact vit dans contact.html, et
# /apps/ose-plus dans apps/ose-plus.html, a cote d'un dossier apps/ose-plus/
# qui contient les pages filles. Sans DirectorySlash Off, Apache renvoie
# vers le dossier et la page ne s'affiche jamais.
DirectorySlash Off

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
