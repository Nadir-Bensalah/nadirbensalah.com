import { MetadataRoute } from 'next';
import { locationPages, pricePages, servicePages } from '@/content/seoPages';
import { blogPosts } from '@/content/blogPosts';
import { caseStudies } from '@/content/caseStudies';
import { englishPricePages, englishServicePages } from '@/content/englishSeoPages';

export default function sitemap(): MetadataRoute.Sitemap {
  const baseUrl = (process.env.NEXT_PUBLIC_SITE_URL || 'https://nadirbensalah.com').replace(/\/$/, '');
  const now = new Date();
  const absoluteUrl = (path: string) => `${baseUrl}${path.startsWith('/') ? path : `/${path}`}`;
  const absoluteAlternates = (paths?: Record<string, string>) => {
    if (!paths) return undefined;

    return Object.fromEntries(
      Object.entries(paths).map(([locale, path]) => [locale, absoluteUrl(path)])
    );
  };

  return [
    { url: baseUrl, lastModified: now, changeFrequency: 'weekly' as const, priority: 1.0 },
    { url: absoluteUrl('/projets'), lastModified: now, changeFrequency: 'monthly' as const, priority: 0.75 },
    { url: absoluteUrl('/tarifs'), lastModified: now, changeFrequency: 'monthly' as const, priority: 0.8 },
    { url: absoluteUrl('/blog'), lastModified: now, changeFrequency: 'weekly' as const, priority: 0.8 },
    { url: absoluteUrl('/etudes-de-cas'), lastModified: now, changeFrequency: 'monthly' as const, priority: 0.8 },
    { url: absoluteUrl('/a-propos'), lastModified: now, changeFrequency: 'monthly' as const, priority: 0.7 },
    { url: absoluteUrl('/contact'), lastModified: now, changeFrequency: 'monthly' as const, priority: 0.9 },
    { url: absoluteUrl('/plan-du-site'), lastModified: now, changeFrequency: 'monthly' as const, priority: 0.55 },
    ...servicePages.map((page) => ({
      url: absoluteUrl(`/services/${page.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: 0.9,
      alternates: { languages: absoluteAlternates({ fr: `/services/${page.slug}`, en: `/en/services/${page.slug}` }) },
    })),
    ...pricePages.map((page) => ({
      url: absoluteUrl(`/prix/${page.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: 0.88,
      alternates: { languages: absoluteAlternates({ fr: `/prix/${page.slug}`, en: `/en/pricing/${page.slug}` }) },
    })),
    ...englishServicePages.map((page) => ({
      url: absoluteUrl(page.path || `/en/services/${page.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: 0.82,
      alternates: { languages: absoluteAlternates(page.alternatePaths) },
    })),
    ...englishPricePages.map((page) => ({
      url: absoluteUrl(page.path || `/en/pricing/${page.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: 0.8,
      alternates: { languages: absoluteAlternates(page.alternatePaths) },
    })),
    ...locationPages.map((page) => ({
      url: absoluteUrl(page.path || `/${page.market}/${page.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: page.market?.startsWith('fr') ? 0.86 : 0.78,
      alternates: { languages: absoluteAlternates(page.alternatePaths) },
    })),
    ...blogPosts.map((post) => ({
      url: absoluteUrl(`/blog/${post.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: post.intent === 'achat' ? 0.78 : 0.68,
    })),
    ...caseStudies.map((study) => ({
      url: absoluteUrl(`/etudes-de-cas/${study.slug}`),
      lastModified: now,
      changeFrequency: 'monthly' as const,
      priority: 0.82,
    })),
  ];
}